ANTHROPIC_API_KEY=sk-ant-your-key-here
DEFAULT_MODEL=claude-sonnet-4-6
LOG_LEVEL=INFO
MAX_TOKENS=2048

# Directory for SQLite DB (and future uploads). Created on first boot.
DATA_DIR=./data

# Environment ("development" = pretty console logs, "production" = JSON logs)
ENV=development

# Per-IP rate limit on POST endpoints. Set to 0 to disable.
RATE_LIMIT_PER_MINUTE=20

# JWT auth — IMPORTANT: change JWT_SECRET in production to a long random string!
JWT_SECRET=change-me-in-production-this-is-not-secure
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Frontend base URL (used for email links + OAuth callbacks). No trailing slash.
FRONTEND_URL=http://localhost:3000

# Sentry error reporting — leave blank to disable
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email delivery
# EMAIL_PROVIDER: "console" (logs only, dev) or "resend"
EMAIL_PROVIDER=console
EMAIL_FROM=PropertyState AI <no-reply@example.com>
RESEND_API_KEY=

# Stripe billing — leave blank to disable. Plans show "Coming Soon" without these.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth — leave blank to disable "Sign in with Google"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated. Add your Vercel URL after deploying the frontend.
# Example: https://property-state-ai.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
